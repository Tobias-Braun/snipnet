-- Local projects. A project exists as soon as a video file is opened, before anything is uploaded, so
-- remote_video_id, proxy_path and court_json are all optional. Structured values (court, draft segments) are
-- stored as JSON text because they are always read and written as a whole.
CREATE TABLE project (
    id TEXT NOT NULL PRIMARY KEY,
    original_path TEXT NOT NULL,
    proxy_path TEXT,
    remote_video_id TEXT,
    court_json TEXT,
    draft_segments_json TEXT,
    base_set_id TEXT,
    draft_edit_log_json TEXT,
    pending_save_json TEXT,
    user_id TEXT,
    created_at_ms INTEGER NOT NULL,
    last_opened_ms INTEGER NOT NULL
);

CREATE INDEX project_last_opened ON project(last_opened_ms DESC);
CREATE INDEX project_user ON project(user_id);

-- Server videos of deleted projects that the server has not confirmed as deleted yet (see migration 3).
CREATE TABLE pending_video_delete (
    user_id TEXT NOT NULL,
    remote_video_id TEXT NOT NULL,
    PRIMARY KEY (user_id, remote_video_id)
);

insertPendingVideoDelete:
INSERT OR IGNORE INTO pending_video_delete(user_id, remote_video_id) VALUES (?, ?);

selectPendingVideoDeletes:
SELECT remote_video_id FROM pending_video_delete WHERE user_id = ? ORDER BY rowid;

deletePendingVideoDelete:
DELETE FROM pending_video_delete WHERE user_id = ? AND remote_video_id = ?;

selectAllForUser:
SELECT * FROM project WHERE user_id = ? ORDER BY last_opened_ms DESC, created_at_ms DESC;

selectOwnerless:
SELECT * FROM project WHERE user_id IS NULL;

deleteOwnerless:
DELETE FROM project WHERE user_id IS NULL;

selectById:
SELECT * FROM project WHERE id = ?;

selectByRemoteVideoId:
SELECT * FROM project WHERE remote_video_id = ? AND user_id = ?;

insert:
INSERT INTO project(id, user_id, original_path, proxy_path, remote_video_id, court_json, draft_segments_json, created_at_ms, last_opened_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectWithPendingSave:
SELECT id FROM project WHERE pending_save_json IS NOT NULL AND user_id = ?;

updateProxyPath:
UPDATE project SET proxy_path = ? WHERE id = ?;

updateRemoteVideoId:
UPDATE project SET remote_video_id = ? WHERE id = ?;

updateCourt:
UPDATE project SET court_json = ? WHERE id = ?;

updateDraft:
UPDATE project SET draft_segments_json = ?, draft_edit_log_json = ? WHERE id = ?;

updateBaseSet:
UPDATE project SET base_set_id = ? WHERE id = ?;

updatePendingSave:
UPDATE project SET pending_save_json = ? WHERE id = ?;

updateSyncedState:
UPDATE project SET base_set_id = ?, draft_edit_log_json = ?, pending_save_json = ? WHERE id = ?;

updateLastOpened:
UPDATE project SET last_opened_ms = ? WHERE id = ?;

deleteById:
DELETE FROM project WHERE id = ?;
