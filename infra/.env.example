# Template for infra/.env (git-ignored). Create it with `sh infra/init-env.sh`, which copies this file and
# fills every empty *_PASSWORD, *_SECRET and *_TOKEN value with a random one. Docker Compose reads infra/.env
# automatically when started with `-f infra/docker-compose.yml`. To run the API or worker outside Docker, load
# it into the shell with `set -a; . infra/.env; set +a` (this also expands the ${...} references below).

# Postgres
POSTGRES_USER=snipnet
POSTGRES_PASSWORD=
POSTGRES_DB=snipnet
# Host port Postgres is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage for the video proxies)
MINIO_ROOT_USER=snipnet
# MinIO requires at least 8 characters.
MINIO_ROOT_PASSWORD=
# Host ports for the S3 API and the web console (bound to 127.0.0.1 only).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Landing page (apps/web): host port of the nginx container (bound to 127.0.0.1 only).
WEB_PORT=8080

# API (services/api)
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
# Overrides the version reported by GET /v1/health; defaults to the package version.
# APP_VERSION=
# Database connection as standard libpq variables (read natively by node-postgres). Inside Docker PGHOST is
# overridden to `postgres`.
PGHOST=localhost
PGPORT=${POSTGRES_PORT}
PGUSER=${POSTGRES_USER}
PGPASSWORD=${POSTGRES_PASSWORD}
PGDATABASE=${POSTGRES_DB}
# Optional schema to use instead of the default `public` (integration tests set it to isolate their tables).
# PGSCHEMA=
# Endpoint the API uses to talk to S3 (inside Docker: http://minio:9000). The presigned proxy URLs handed to the
# inference worker use it too, so it must be reachable from the worker.
S3_ENDPOINT=http://localhost:${MINIO_API_PORT}
# Endpoint used in presigned URLs handed to clients; must be reachable from the desktop app.
S3_PUBLIC_ENDPOINT=http://localhost:${MINIO_API_PORT}
S3_REGION=us-east-1
S3_BUCKET=snipnet-proxies
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
# The API refuses to start without the three secrets below (at least 16 characters each; init-env.sh generates them).
# Secret for signing user JWTs.
JWT_SECRET=
# Shared secret between the API and the inference worker for /internal/* (Authorization: Bearer <token>).
INTERNAL_TOKEN=
# Token for /v1/admin/* (training export).
ADMIN_TOKEN=
# Origin(s) of the landing page allowed to call the public API cross-origin (comma separated, no trailing slash).
# Leave empty to disable CORS.
WEB_ORIGIN=http://localhost:${WEB_PORT}
# Behind a reverse proxy: its addresses/CIDRs (comma separated, e.g. `uniquelocal` for the Compose network), so
# per-IP rate limits see the real client. `true` and hop counts are refused because clients could spoof their IP.
# TRUST_PROXY=false
# Per-IP limit of POST /v1/waitlist: requests per window.
# WAITLIST_RATE_LIMIT_MAX=10
# WAITLIST_RATE_LIMIT_WINDOW_SECONDS=60

# Inference worker (services/inference)
API_URL=http://localhost:${API_PORT}
# Defaults to the hostname when empty.
WORKER_ID=
WORKER_POLL_INTERVAL_S=2
# Model the worker loads (see snipnet_ml.load_model).
MODEL=dummy-v0
